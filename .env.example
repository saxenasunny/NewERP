# Copy this file to .env.local for local development:  cp .env.example .env.local
# Never commit .env.local or real credentials. Every value below is a placeholder.

# --- Application -----------------------------------------------------------
# Absolute origin the app is served from. Used for absolute links, cookies and
# (later) email links. No trailing slash.
APP_BASE_URL="http://localhost:3000"

# --- Database --------------------------------------------------------------
# PostgreSQL connection string. Matches docker-compose.yml (development only).
DATABASE_URL="postgresql://lms:lms_dev_password@localhost:5432/lms_dev?schema=public"

# Optional: dedicated database for integration tests. It must be a different
# database from DATABASE_URL; tests refuse to run against a non-test database.
# TEST_DATABASE_URL="postgresql://lms:lms_dev_password@localhost:5432/lms_test?schema=public"

# --- Authentication --------------------------------------------------------
# Secret used to sign/derive session artefacts. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. Development value is a placeholder only.
AUTH_SECRET="dev-only-placeholder-replace-me-32-chars-min"

# Development-only password for the seeded demo accounts. Never reuse it
# outside development; the seed refuses to run in production.
# SEED_DEMO_PASSWORD="DemoPassword2026!"

# --- Not yet configured (documented now, wired in later phases) ------------
# Email delivery is not configured. Development captures messages in the
# email_messages table and shows them at /dev/mail; nothing is sent.
# EMAIL_PROVIDER=""

# --- Course file storage ---------------------------------------------------
# "local" (default outside production) writes files under .data/storage, which
# is gitignored. "s3" is required in production and speaks any S3-compatible API.
# The S3 adapter is installed but NOT verified against a real bucket yet: set
# these and test uploads/downloads before relying on it. See
# docs/runbooks/object-storage.md.
# STORAGE_DRIVER="local"
# STORAGE_LOCAL_ROOT=".data/storage"
#
# OBJECT_STORAGE_ENDPOINT="https://s3.example.com"
# OBJECT_STORAGE_BUCKET="lms-course-files"
# OBJECT_STORAGE_REGION="eu-west-1"
# OBJECT_STORAGE_ACCESS_KEY_ID=""
# OBJECT_STORAGE_SECRET_ACCESS_KEY=""
# OBJECT_STORAGE_SESSION_TOKEN=""
# OBJECT_STORAGE_FORCE_PATH_STYLE="true"

# --- Inbound webhooks ------------------------------------------------------
# One shared secret per provider, at least 16 characters. The endpoint reads
# WEBHOOK_<PROVIDER>_SECRET (upper-case provider, non-alphanumerics to "_").
# A provider without a secret is refused with 503 rather than accepted unsigned.
# WEBHOOK_STRIPE_SECRET=""
# WEBHOOK_ACME_PAYMENTS_SECRET=""

# Sender label on transactional email. Delivery itself is still unconfigured.
# EMAIL_FROM="LMS Platform <no-reply@lms.example>"

# Error reporting is not configured.
# ERROR_REPORTING_DSN=""
